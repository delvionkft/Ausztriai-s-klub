# =============================================================================
#  KÖRNYEZETI VÁLTOZÓK
# =============================================================================
#  Másold `.env.local` néven, és töltsd ki. A `.env.local` NEM kerül verziókezelésbe.
#  FONTOS: API-kulcs, jelszó vagy titkos érték SOHA nem kerül a kódba.
#
#  A `NEXT_PUBLIC_` előtagú változók a böngészőbe is eljutnak — ide csak
#  nyilvános értéket tegyél. Titkos kulcsot kizárólag előtag nélküli
#  változóban, szerveroldalon használj.
# =============================================================================

# Az oldal nyilvános alap-URL-je. Kanonikus linkekhez, sitemaphoz és Open Graphhoz.
# Példa: https://sikozpont.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
#  BACKEND (Emergent) — amíg üres, a felület a src/data/* mock adatokból dolgozik
# -----------------------------------------------------------------------------
# A REST API gyökere. Beállítás után a src/services/apiClient.ts éles hívásokat indít.
# Példa: https://api.sikozpont.example/v1
NEXT_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
#  KÜLSŐ SZOLGÁLTATÁSOK (opcionális, éles működéshez)
# -----------------------------------------------------------------------------
# Google Maps beágyazás — alternatívaként a src/data/contact.ts mapEmbedUrl mezője is használható.
NEXT_PUBLIC_MAPS_EMBED_URL=

# Webanalitika (pl. Plausible / Umami) — nyilvános azonosító.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# -----------------------------------------------------------------------------
#  SZERVEROLDALI TITKOK — kizárólag backend környezetben, NEXT_PUBLIC_ nélkül!
# -----------------------------------------------------------------------------
# Ajánlatkérő e-mail továbbítás (pl. Resend / SendGrid).
# EMAIL_API_KEY=
# EMAIL_TO=

# Jegyértékesítő rendszer integrációja.
# TICKETING_API_KEY=

# Foglalási rendszer / channel manager.
# BOOKING_API_KEY=

# Időjárás- és hóadat szolgáltató.
# WEATHER_API_KEY=
