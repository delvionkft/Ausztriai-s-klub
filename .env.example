# =============================================================================
#  KÖRNYEZETI VÁLTOZÓK
# =============================================================================
#  Másold `.env.local` néven, és töltsd ki. A `.env.local` NEM kerül verziókezelésbe.
#  API-kulcs, jelszó vagy titkos érték SOHA nem kerül a kódba.
#
#  A `NEXT_PUBLIC_` előtagú változók a böngészőbe is eljutnak — ide csak
#  nyilvános érték kerülhet. Titkos kulcsot kizárólag előtag nélküli
#  változóban, szerveroldalon használj.
#
#  MINDEN VÁLTOZÓ ELHAGYHATÓ: nélkülük a weboldal a `src/data/*` mintaadataiból
#  dolgozik, és minden funkció működik.
# =============================================================================

# -----------------------------------------------------------------------------
#  ALAPOK
# -----------------------------------------------------------------------------
# Az oldal nyilvános alap-URL-je. Kanonikus linkekhez, sitemaphoz, Open Graphhoz.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Szezonvezérlés: auto | winter | summer
#   auto   -> a dátum dönti el, téli vagy nyári üzemmódot mutat az oldal
#   winter -> mindig téli üzem (bemutatóhoz ez az alapértelmezés)
#   summer -> mindig nyári üzem
NEXT_PUBLIC_SEASON_MODE=winter

# -----------------------------------------------------------------------------
#  KÉPEK
# -----------------------------------------------------------------------------
# Ha saját CDN-ről szolgálod ki a `public/images/` tartalmát, add meg a gyökeret.
# Üresen hagyva a képek a saját domainről töltődnek.
# Példa: https://cdn.sikozpont.hu
NEXT_PUBLIC_IMAGE_CDN=

# -----------------------------------------------------------------------------
#  BACKEND — amíg üres, a felület a src/data/* mintaadatokból dolgozik
# -----------------------------------------------------------------------------
# A REST API gyökere. Beállítás után a src/services/* éles hívásokat indít:
#   GET  /status         -> hó- és üzemállapot
#   GET  /forecast       -> háromnapos előrejelzés
#   GET  /availability   -> foglaltsági naptár (?year=&month=)
#   POST /inquiries      -> ajánlatkérés
#   POST /newsletter     -> hóértesítő feliratkozás
#   POST /checkout       -> jegyvásárlás indítása
NEXT_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
#  MÉRÉS
# -----------------------------------------------------------------------------
# Google Tag Manager konténer. Megadás után a src/lib/analytics.ts eseményei
# a dataLayerbe kerülnek, és a GTM továbbítja őket.
NEXT_PUBLIC_GTM_ID=

# GA4 mérőazonosító. Csak akkor használjuk, ha nincs GTM-konténer megadva.
NEXT_PUBLIC_GA4_ID=

# -----------------------------------------------------------------------------
#  TÉRKÉP
# -----------------------------------------------------------------------------
# Beágyazott térkép URL-je. Üresen hagyva OpenStreetMap beágyazás fut
# (nem igényel API-kulcsot). Google Maps embed URL is megadható.
NEXT_PUBLIC_MAPS_EMBED_URL=

# -----------------------------------------------------------------------------
#  SZERVEROLDALI TITKOK — kizárólag backend környezetben, NEXT_PUBLIC_ nélkül!
# -----------------------------------------------------------------------------
# Ajánlatkérő e-mail továbbítás (pl. Resend / SendGrid / Brevo).
# EMAIL_API_KEY=
# EMAIL_TO=

# Jegyértékesítő rendszer (pl. Skidata, Axess).
# TICKETING_API_KEY=

# Foglalási rendszer / channel manager.
# BOOKING_API_KEY=

# Hó- és időjárásadat-szolgáltató.
# WEATHER_API_KEY=

# Webkamera-szolgáltató.
# WEBCAM_API_KEY=
